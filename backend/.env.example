# ==============================================================================
# RentTrack Backend Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file containing real secrets to source control!
# ==============================================================================

# Application Server & Client CORS
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/rentTrack_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=rentTrack_db
DATABASE_SSL=false

# Authentication & Security
# Generate a cryptographically secure 256-bit key using: openssl rand -hex 64
JWT_SECRET=your_super_secret_jwt_key_min_64_characters_here
JWT_EXPIRES_IN=24h
JWT_ISSUER=renttrack-api
JWT_AUDIENCE=renttrack-app
BCRYPT_SALT_ROUNDS=12

# Automated Cron Security Secret
# Secret key required to authorize automated billing and reminder cron endpoints
CRON_SECRET=your_secure_cron_secret_key_here
