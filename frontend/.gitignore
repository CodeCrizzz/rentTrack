# ==============================================================================
# RentTrack Frontend .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
.nyc_output/

# Next.js Build Output
/.next/
/out/
/build
/dist

# Environment Variables & Secrets
.env
.env.*
.env*.local
!.env.example

# Cryptographic Keys & Certificates
*.pem
*.key
*.pub
*.cert
*.crt

# Service Worker & PWA bundles
public/sw*
public/swe-worker*

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & Cloud
.vercel
.netlify

# TypeScript & Next.js generated types
*.tsbuildinfo
next-env.d.ts

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
