# ==============================================================================
# RentTrack Root Security & Repository .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & API Credentials (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Universal recursive environment file exclusions
**/.env
**/.env.*
**/.env*.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.production
frontend/.env.development

# Always allow version-controlled sanitized example templates
!.env.example
!backend/.env.example
!frontend/.env.example
!*.env.example

# Generic secrets, tokens & credential configuration files
.secrets
secrets.*
*.secret
*.token
credentials.json
client_secret*.json
*service-account*.json
firebase-adminsdk*.json
supabase/.temp/
supabase/.branches/

# ------------------------------------------------------------------------------
# 2. Cryptographic Keys, Certificates & Keystores (CRITICAL)
# ------------------------------------------------------------------------------
*.pem
*.key
*.pub
*.cert
*.cer
*.crt
*.der
*.pfx
*.p12
*.pkcs12
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.ssh/
*.gpg
*.asc

# ------------------------------------------------------------------------------
# 3. User Uploads, Tenant PII & Payment Receipts (CRITICAL)
# ------------------------------------------------------------------------------
uploads/
*/uploads/
backend/uploads/
frontend/public/uploads/

# ------------------------------------------------------------------------------
# 4. Database Dumps, Backups & Local Data Stores
# ------------------------------------------------------------------------------
*.sql
*.dump
*.pgdump
*.psql
*.bak
*.backup
*.sqlite
*.sqlite3
*.db
*.rdb
dump.rdb
*.tar
*.tar.gz
*.zip

# ------------------------------------------------------------------------------
# 5. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# 6. Build Artifacts, Bundles & Compilations
# ------------------------------------------------------------------------------
.next/
frontend/.next/
*/.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Serwist / Progressive Web App Service Workers
frontend/public/sw*
frontend/public/swe-worker*
public/sw*
public/swe-worker*

# Cloud deployment traces
.vercel
.netlify

# ------------------------------------------------------------------------------
# 7. System Logs, Process Files & Debugging Traces
# ------------------------------------------------------------------------------
*.log
logs/
*/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.pid
*.pid.lock
*.seed
core.*
*.crash

# ------------------------------------------------------------------------------
# 8. Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
*/coverage/
.nyc_output/
test-results/

# ------------------------------------------------------------------------------
# 9. Temporary & Scratch Workspaces
# ------------------------------------------------------------------------------
tmp/
temp/
scratch/
*/scratch/

# ------------------------------------------------------------------------------
# 10. Operating System & IDE Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# IDEs
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 11. Internal Architecture, System Workflows & Database Scripts
# ------------------------------------------------------------------------------
RENTTRACK_SYSTEM_DFD.txt
create_tables.txt
activity_logs_workflow.txt
gane_and_sarson_dfd_workspace.txt
project_review.txt
system_scope.txt
use_case_diagram.txt
full_workflow.txt

