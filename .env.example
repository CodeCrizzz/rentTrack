# ==============================================================================
# RentTrack Root Monorepo Environment Configuration Guide
# ==============================================================================
#
# Backend:
#   Navigate to /backend and copy .env.example to .env:
#     cd backend && cp .env.example .env
#
# Frontend:
#   Navigate to /frontend and copy .env.example to .env.local:
#     cd frontend && cp .env.example .env.local
#
# DO NOT commit any '.env' or '.env.local' files containing real secrets!
# ==============================================================================
